# Required for browser/mobile push notifications. Generate a VAPID pair with:
# npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
CRON_SECRET=replace-with-a-long-random-secret
OPEN_ENQUIRY_ESCALATION_RECIPIENT=tech@theadityagroup.com
GOOGLE_FORM_ID=replace-with-the-form-editor-id
FORM_SYNC_SECRET=replace-with-a-long-random-secret
# Required to send response confirmation email. SMTP_PASS should be an app password where required.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-with-sender-email
SMTP_PASS=replace-with-smtp-password
# SMTP_FROM=Aditya Group <sender@example.com>
